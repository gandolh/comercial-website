{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Inside dist/, so deleting dist/ also forgets what was built: tsc -b would otherwise call a missing
    // dist/ up to date.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "references": [{ "path": "../core" }],
  "include": ["src/**/*"]
}
