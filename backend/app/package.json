{
  "name": "@my-olx/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs');if(fs.existsSync('src/data'))fs.cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "seed:dev": "tsx src/seed-dev.ts",
    "create-owner": "tsx src/create-owner.ts",
    "seed:samples": "tsx src/seed-samples.ts"
  },
  "dependencies": {
    "@my-olx/core": "0.1.0",
    "better-sqlite3": "11.7.0",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "kysely": "0.28.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12"
  }
}
