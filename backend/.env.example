DATABASE_PATH=./data/my-olx.db
UPLOADS_DIR=./data/uploads
# Files for sale, outside the public uploads folder
ASSETS_DIR=./data/assets
PUBLIC_BASE_URL=http://localhost:8080
JWT_SECRET=change-me-in-production
JWT_EXPIRY_SECONDS=86400
HOST=0.0.0.0
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
# fatal, error, warn, info (the default), debug, trace or silent
LOG_LEVEL=debug
# Proxies whose X-Forwarded-For the API believes, comma-separated (loopback by default)
# TRUSTED_PROXIES=loopback

# The owner's account, for `npm run create-owner` (sign-up is closed)
# OWNER_EMAIL=
# OWNER_PASSWORD=
# OWNER_NAME=

# Sign in with Ward: set all of these, or leave WARD_OIDC_ISSUER empty for password login only
# WARD_OIDC_ISSUER=
# WARD_OIDC_CLIENT_ID=
# WARD_OIDC_CLIENT_KEY=
# WARD_OIDC_REDIRECT_URI=
# WARD_OIDC_POST_LOGOUT_REDIRECT_URI=
