{
  "name": "@my-olx/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b && npm run copy-assets",
    "copy-assets": "node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@my-olx/core": "0.1.0",
    "fastify": "5.2.1",
    "kysely": "0.27.5",
    "better-sqlite3": "11.7.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12"
  }
}
