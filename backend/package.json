{
  "name": "my-olx-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @my-olx/app",
    "build": "npm run build --workspace @my-olx/app",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -b app",
    "lint": "eslint .",
    "knip": "knip",
    "check:fast": "npm run typecheck && node ../scripts/check-fast.mjs",
    "migrate": "npm run migrate --workspace @my-olx/app",
    "seed:dev": "npm run seed:dev --workspace @my-olx/app",
    "create-owner": "npm run create-owner --workspace @my-olx/app",
    "seed:samples": "npm run seed:samples --workspace @my-olx/app"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "vitest": "4.1.12",
    "@types/node": "22.10.5"
  }
}
